# SMDPIS environment configuration.
# Copy to .env and adjust values. All variables are optional in development;
# defaults are shown below. NEVER commit a real .env file.

# Runtime environment label (development | production | test)
SMDPIS_ENV=development

# Logging level (DEBUG | INFO | WARNING | ERROR)
SMDPIS_LOG_LEVEL=INFO

# Secret used to HMAC-sign audit/chain-of-custody events.
# CHANGE THIS in production (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
SMDPIS_SECRET_KEY=dev-insecure-secret-change-me

# Generate sample data, ingest, and train baseline models on startup.
SMDPIS_AUTO_BOOTSTRAP=true

# Comma-separated allowed browser origins for the API.
SMDPIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLAlchemy database URL.
# Development default (SQLite):  sqlite:///../data/smdpis.db  (relative to backend/)
# Production (PostgreSQL):       postgresql+psycopg://smdpis:smdpis@postgres:5432/smdpis
# Docker Compose sets this automatically for the backend service.
# SMDPIS_DATABASE_URL=sqlite:///data/smdpis.db

# Maximum dataset upload size in megabytes.
SMDPIS_MAX_UPLOAD_MB=50

# Comma-separated allowed upload extensions.
SMDPIS_ALLOWED_EXTENSIONS=csv,json,jsonl,parquet

# Where uploaded/generated datasets and evidence bundles are stored.
SMDPIS_DATA_DIR=data

# Where trained model artifacts are stored.
SMDPIS_MODEL_DIR=models

# --- Web collection (public sources only) ----------------------------------
# Master switch for /api/datasets/{fetch,collect,crawl}. Disabling it makes the
# endpoints return 403 while leaving uploads untouched.
SMDPIS_FETCH_ENABLED=true

# Identifying User-Agent sent with every outbound request.
SMDPIS_USER_AGENT=SMDPIS/1.0 (+public-data-collection; authorized-use)

# Per-request timeout in seconds.
SMDPIS_FETCH_TIMEOUT=20

# Maximum size of a fetched document, in megabytes.
SMDPIS_FETCH_MAX_MB=50

# Redirect hops allowed. Every hop is re-validated against the SSRF policy.
SMDPIS_FETCH_MAX_REDIRECTS=5

# Minimum seconds between requests to the same host (politeness delay).
SMDPIS_FETCH_MIN_INTERVAL=1.0

# NEVER set this to true in production. false (default) blocks loopback,
# RFC1918, link-local and other non-public targets — including via redirects.
# Setting it true is only useful for hitting a local test fixture.
SMDPIS_FETCH_ALLOW_PRIVATE=false

# Honour robots.txt on every outbound request.
SMDPIS_ROBOTS_OBEY=true

# Optional comma-separated hostname allow-list. When set, only these hosts
# (and their subdomains) may be contacted. Empty = any public host.
SMDPIS_FETCH_HOST_ALLOWLIST=

# Crawler ceilings (per-request values may go lower but never higher).
SMDPIS_CRAWL_MAX_PAGES=10
SMDPIS_CRAWL_MAX_DEPTH=2

# Maximum records returned by a platform-source collection.
SMDPIS_COLLECT_MAX_ITEMS=500
